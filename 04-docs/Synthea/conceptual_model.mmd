  %% Hub relationships
  ENCOUNTER }o--|| PATIENT : "subject"
  ENCOUNTER }o--|| ORGANIZATION : "serviceProvider"
  ENCOUNTER }o--|| LOCATION : "location"
  ENCOUNTER }o--|| PRACTITIONERROLE : "participant"
