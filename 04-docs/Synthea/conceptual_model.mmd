  %% Financials
  CLAIM }o--|| PATIENT : "patient"
  CLAIM }o--o| ENCOUNTER : "encounter"
  CLAIM }o--o| ORGANIZATION : "provider"
  EXPLANATIONOFBENEFIT }o--|| PATIENT : "patient"
  EXPLANATIONOFBENEFIT }o--o| ENCOUNTER : "encounter"
  EXPLANATIONOFBENEFIT }o--o| ORGANIZATION : "provider"

  %% Supply & provenance
  SUPPLYDELIVERY }o--|| PATIENT : "patient"
