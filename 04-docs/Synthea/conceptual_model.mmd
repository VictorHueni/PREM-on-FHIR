  PRACTITIONERROLE }o--|| ORGANIZATION : "organization"
  CARETEAM }o--o| PRACTITIONER : "participant"
  CARETEAM }o--o| ORGANIZATION : "participant"

  %% Most resources link to patient (+ often encounter)
  CONDITION }o--|| PATIENT : "subject"
  CONDITION }o--o| ENCOUNTER : "encounter"
  OBSERVATION }o--|| PATIENT : "subject"
  OBSERVATION }o--o| ENCOUNTER : "encounter"
  PROCEDURE }o--|| PATIENT : "subject"
  PROCEDURE }o--o| ENCOUNTER : "encounter"
  IMMUNIZATION }o--|| PATIENT : "patient"
  IMMUNIZATION }o--o| ENCOUNTER : "encounter"
  DEVICE }o--|| PATIENT : "patient"
  MEDICATIONREQUEST }o--|| PATIENT : "subject"
  MEDICATIONREQUEST }o--o| ENCOUNTER : "encounter"
  MEDICATIONADMINISTRATION }o--|| PATIENT : "subject"
  MEDICATIONADMINISTRATION }o--o| ENCOUNTER : "encounter"
  IMAGINGSTUDY }o--|| PATIENT : "subject"
  IMAGINGSTUDY }o--o| ENCOUNTER : "encounter"

  %% Reports & documents
  DIAGNOSTICREPORT }o--|| PATIENT : "subject"
  DIAGNOSTICREPORT }o--o| ENCOUNTER : "encounter"
