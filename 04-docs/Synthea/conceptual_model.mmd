erDiagram
  direction LR
  %% Core actors
  PATIENT { string id }
  ORGANIZATION { string id }
  LOCATION { string id }
  PRACTITIONER { string id }
  PRACTITIONERROLE { string id }
  CARETEAM { string id }
  PAYER { string id }

  ENCOUNTER {
    string idP
    string patient_id
    string organization_id
    string location_id
    string practitionerrole_id
  }

  %% Clinical content (subject+encounter oriented)
  CONDITION { string id }
  OBSERVATION { string id }
  PROCEDURE { string id }
  IMMUNIZATION { string id }
  DEVICE { string id }
  MEDICATION { string id }
